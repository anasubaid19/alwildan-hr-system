# PostgreSQL (Docker — lihat docker-compose.yml)
DATABASE_URL="postgresql://alwildan:alwildan2026@localhost:5432/alwildan_hr"

# Better Auth — WAJIB ganti secret: openssl rand -base64 32
BETTER_AUTH_SECRET="ganti-dengan-secret-32-char"
# URL yang dipakai pengguna mengakses app. Salah isi = login ditolak
# "invalid origin". Deploy server: http://IP_SERVER:APP_PORT
# (mis. http://192.168.1.100:3100) atau https://domain.
BETTER_AUTH_URL="http://localhost:3100"

# Port host untuk container app (Docker) — satu port dedicated untuk web.
# Harus sama dengan port di BETTER_AUTH_URL & script dev.
APP_PORT=3100

# Password Postgres container (Docker) — ganti di server produksi.
# DATABASE_URL container otomatis mengikuti nilai ini.
POSTGRES_PASSWORD=alwildan2026

# Email transaksional (reset password) via Resend — https://resend.com
# Kosongkan di dev lokal: link reset dicetak ke console.
RESEND_API_KEY=""
EMAIL_FROM="Al Wildan HR <no-reply@domainmu.com>"

# AI Provider (default Groq, kompatibel OpenAI)
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_API_KEY="gsk_xxx"
AI_MODEL="llama-3.3-70b-versatile"
