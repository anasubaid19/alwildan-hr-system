# Server
PORT=3010
NODE_ENV=development

# Database path — default berdasarkan __dirname (backend/data/alwildan.db), cwd-independent.
# Override hanya jika perlu, dan pakai ABSOLUTE path:
# DB_PATH=/full/path/to/data/alwildan.db

# JWT — WAJIB diisi di production dengan string acak minimal 32 karakter.
# Tanpa ini, aplikasi memakai secret fallback hardcoded yang TIDAK AMAN.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# AI Provider (diisi via halaman Settings, bisa juga di-override lewat .env)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
